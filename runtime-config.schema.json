{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/IRuntimeConfig",
    "definitions": {
        "IRuntimeConfig": {
            "type": "object",
            "properties": {
                "miner": {
                    "$ref": "#/definitions/IConfigMiner"
                },
                "batchServices": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/IConfigBatchService"
                    }
                },
                "$schema": {
                    "type": "string"
                },
                "trader": {
                    "$ref": "#/definitions/IRuntimeTraderConfig"
                }
            },
            "required": [
                "trader"
            ],
            "additionalProperties": false
        },
        "IConfigMiner": {
            "type": "object",
            "properties": {
                "kinds": {
                    "type": "object",
                    "properties": {
                        "intraday": {
                            "$ref": "#/definitions/IConfigMinerKind"
                        },
                        "swing": {
                            "$ref": "#/definitions/IConfigMinerKind"
                        },
                        "position": {
                            "$ref": "#/definitions/IConfigMinerKind"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "required": [
                "kinds"
            ],
            "additionalProperties": false
        },
        "IConfigMinerKind": {
            "type": "object",
            "properties": {
                "minMovePerc": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "required": [
                "minMovePerc"
            ],
            "additionalProperties": false
        },
        "IConfigBatchService": {
            "type": "object",
            "properties": {
                "rateLimit": {
                    "$ref": "#/definitions/IConfigRateLimit"
                },
                "meta": {
                    "type": "object",
                    "additionalProperties": {}
                },
                "flatFiles": {
                    "$ref": "#/definitions/IConfigMassiveFlatFiles"
                }
            },
            "additionalProperties": false
        },
        "IConfigRateLimit": {
            "type": "object",
            "properties": {
                "requests": {
                    "type": "number",
                    "minimum": 1
                },
                "windowMs": {
                    "type": "number",
                    "minimum": 1
                },
                "minDelayMs": {
                    "type": "number",
                    "minimum": 0
                }
            },
            "required": [
                "requests",
                "windowMs"
            ],
            "additionalProperties": false
        },
        "IConfigMassiveFlatFiles": {
            "type": "object",
            "properties": {
                "ohlc": {
                    "$ref": "#/definitions/IConfigMassiveFlatFileDataset"
                },
                "trades": {
                    "$ref": "#/definitions/IConfigMassiveFlatFileDataset"
                },
                "quotes": {
                    "$ref": "#/definitions/IConfigMassiveFlatFileDataset"
                }
            },
            "additionalProperties": false
        },
        "IConfigMassiveFlatFileDataset": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "from": {
                    "type": "string",
                    "format": "date-time"
                },
                "rawArchivePath": {
                    "type": "string"
                },
                "universe": {
                    "$ref": "#/definitions/IConfigMassiveFlatFileUniverse"
                }
            },
            "required": [
                "enabled"
            ],
            "additionalProperties": false
        },
        "IConfigMassiveFlatFileUniverse": {
            "type": "object",
            "properties": {
                "symbols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "instrumentPoolIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "IRuntimeTraderConfig": {
            "type": "object",
            "properties": {
                "instrumentUniverse": {
                    "$ref": "#/definitions/IConfigInstrumentUniverse"
                },
                "riskProfiles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IConfigRiskProfile"
                    }
                },
                "strategyRiskOverrides": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IConfigStrategyRiskOverride"
                    }
                },
                "defaultMaxLossPerDay": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxContextBars": {
                    "type": "number"
                },
                "avoidRoundShareQuantities": {
                    "type": "boolean"
                },
                "approachingSignals": {
                    "$ref": "#/definitions/IConfigApproachSignals"
                },
                "backtest": {
                    "$ref": "#/definitions/IConfigBacktest"
                },
                "live": {
                    "$ref": "#/definitions/IConfigLiveTrading"
                },
                "notifications": {
                    "type": "object",
                    "properties": {
                        "info": {
                            "$ref": "#/definitions/INotificationConfig"
                        },
                        "error": {
                            "$ref": "#/definitions/INotificationConfig"
                        }
                    },
                    "additionalProperties": false
                },
                "strategies": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "approachingSignals",
                "backtest",
                "defaultMaxLossPerDay",
                "instrumentUniverse",
                "live",
                "maxContextBars",
                "notifications",
                "riskProfiles",
                "strategies",
                "strategyRiskOverrides"
            ],
            "additionalProperties": false
        },
        "IConfigInstrumentUniverse": {
            "type": "object",
            "properties": {
                "poolIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "symbols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "excludedSymbols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "IConfigRiskProfile": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "maxRiskPercPerTrade": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "maxDrawdownPercPerDay": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "hv": {
                    "$ref": "#/definitions/IConfigHVRule"
                },
                "backtest": {
                    "$ref": "#/definitions/IConfigRiskBacktestProfile"
                },
                "minCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxSpreadPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxDailyVolumeParticipationPerTrade": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "minRecentExecutionBars": {
                    "type": "number",
                    "minimum": 0
                },
                "maxExecutionBarGapFactor": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "minSignalScore": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "required": [
                "id",
                "maxRiskPercPerTrade",
                "maxDrawdownPercPerDay"
            ],
            "additionalProperties": false
        },
        "IConfigHVRule": {
            "type": "object",
            "properties": {
                "bands": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "threshold": {
                                "type": [
                                    "number",
                                    "null"
                                ],
                                "minimum": 0
                            },
                            "riskMultiplier": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                            }
                        },
                        "required": [
                            "threshold",
                            "riskMultiplier"
                        ],
                        "additionalProperties": false
                    }
                },
                "lookbackDays": {
                    "type": "number",
                    "minimum": 1
                },
                "shock": {
                    "type": "number",
                    "exclusiveMinimum": 0
                }
            },
            "required": [
                "bands",
                "lookbackDays",
                "shock"
            ],
            "additionalProperties": false
        },
        "IConfigRiskBacktestProfile": {
            "type": "object",
            "properties": {
                "spreadFactor": {
                    "type": "number",
                    "minimum": 0
                },
                "slippageFactor": {
                    "type": "number",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "ICompositeValue": {
            "type": "object",
            "properties": {
                "value": {
                    "type": "number",
                    "minimum": 0
                },
                "type": {
                    "$ref": "#/definitions/IValueKind"
                }
            },
            "required": [
                "value"
            ],
            "additionalProperties": false
        },
        "IValueKind": {
            "type": "string",
            "enum": [
                "fixed",
                "perc"
            ]
        },
        "IConfigStrategyRiskOverride": {
            "type": "object",
            "properties": {
                "strategyProfileId": {
                    "$ref": "#/definitions/StrategyRiskProfileId"
                },
                "preferredRiskProfileId": {
                    "type": "string"
                },
                "maxRiskPercPerTrade": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "maxDrawdownPercPerDay": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "hv": {
                    "$ref": "#/definitions/IConfigHVRuleOverride"
                },
                "backtest": {
                    "$ref": "#/definitions/IConfigRiskBacktestProfile"
                },
                "minCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxSpreadPerTrade": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maxDailyVolumeParticipationPerTrade": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "minRecentExecutionBars": {
                    "type": "number",
                    "minimum": 0
                },
                "maxExecutionBarGapFactor": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "minSignalScore": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "required": [
                "strategyProfileId"
            ],
            "additionalProperties": false
        },
        "StrategyRiskProfileId": {
            "type": "string",
            "enum": [
                "default",
                "eventDriven",
                "scalping.trend",
                "scalping.breakout",
                "scalping.meanReversion",
                "scalping.range",
                "scalping.liquidity",
                "scalping.volatility",
                "intraday.trend",
                "intraday.breakout",
                "intraday.meanReversion",
                "intraday.range",
                "intraday.liquidity",
                "intraday.futures",
                "intraday.volatility",
                "swing.trend",
                "swing.breakout",
                "swing.meanReversion",
                "swing.range",
                "swing.liquidity",
                "swing.volatility",
                "position.trend",
                "position.breakout",
                "position.meanReversion",
                "position.range",
                "position.liquidity",
                "position.volatility"
            ]
        },
        "IConfigHVRuleOverride": {
            "type": "object",
            "properties": {
                "bands": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "threshold": {
                                "type": [
                                    "number",
                                    "null"
                                ],
                                "minimum": 0
                            },
                            "riskMultiplier": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                            }
                        },
                        "required": [
                            "threshold",
                            "riskMultiplier"
                        ],
                        "additionalProperties": false
                    }
                },
                "lookbackDays": {
                    "type": "number",
                    "minimum": 1
                },
                "shock": {
                    "type": "number",
                    "exclusiveMinimum": 0
                }
            },
            "additionalProperties": false
        },
        "IConfigApproachSignals": {
            "type": "object",
            "properties": {
                "active": {
                    "type": "object",
                    "properties": {
                        "live": {
                            "type": "boolean"
                        },
                        "backtest": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "live",
                        "backtest"
                    ],
                    "additionalProperties": false
                },
                "notify": {
                    "type": "boolean"
                }
            },
            "required": [
                "active",
                "notify"
            ],
            "additionalProperties": false
        },
        "IConfigBacktest": {
            "type": "object",
            "properties": {
                "useStrategyScores": {
                    "type": "boolean"
                },
                "startDate": {
                    "type": "string",
                    "format": "date-time"
                },
                "endDate": {
                    "type": "string",
                    "format": "date-time"
                },
                "spread": {
                    "$ref": "#/definitions/IBacktestSpreadValue"
                },
                "slippage": {
                    "$ref": "#/definitions/ICompositeDynamicValue"
                },
                "executionBarVolumeParticipation": {
                    "type": "number"
                },
                "optimization": {
                    "$ref": "#/definitions/IConfigBacktestOptimization"
                },
                "profiling": {
                    "type": "boolean"
                },
                "journalKind": {
                    "$ref": "#/definitions/JournalKind"
                },
                "initialCapital": {
                    "type": "number"
                }
            },
            "required": [
                "useStrategyScores",
                "executionBarVolumeParticipation",
                "initialCapital"
            ],
            "additionalProperties": false
        },
        "IBacktestSpreadValue": {
            "anyOf": [
                {
                    "$ref": "#/definitions/ICompositeDynamicValue"
                },
                {
                    "$ref": "#/definitions/IObservedSpreadValue"
                }
            ]
        },
        "ICompositeDynamicValue": {
            "anyOf": [
                {
                    "$ref": "#/definitions/ICompositeValue"
                },
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "dynamic"
                        }
                    },
                    "required": [
                        "type"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "IObservedSpreadValue": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "observed"
                },
                "minimumCoverage": {
                    "type": "number"
                },
                "maximumAgeMs": {
                    "type": "number"
                }
            },
            "required": [
                "type",
                "minimumCoverage",
                "maximumAgeMs"
            ],
            "additionalProperties": false
        },
        "IConfigBacktestOptimization": {
            "type": "object",
            "properties": {
                "maxDrawings": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5000,
                    "multipleOf": 1
                },
                "omitBenchmarks": {
                    "type": "boolean"
                },
                "omitSignals": {
                    "type": "boolean"
                },
                "omitNotifications": {
                    "type": "boolean"
                },
                "omitEquityCurve": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        },
        "JournalKind": {
            "type": "string",
            "enum": [
                "standard",
                "research",
                "oracle"
            ]
        },
        "IConfigLiveTrading": {
            "type": "object",
            "properties": {
                "useStrategyScores": {
                    "type": "boolean"
                }
            },
            "required": [
                "useStrategyScores"
            ],
            "additionalProperties": false
        },
        "INotificationConfig": {
            "type": "object",
            "properties": {
                "channels": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/NotificationChannel"
                    }
                },
                "webhooks": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/INotificationConfigWebhook"
                    }
                },
                "telegram": {
                    "$ref": "#/definitions/INotificationConfigTelegram"
                }
            },
            "required": [
                "channels"
            ],
            "additionalProperties": false
        },
        "NotificationChannel": {
            "type": "string",
            "enum": [
                "app",
                "webhook",
                "telegram"
            ]
        },
        "INotificationConfigWebhook": {
            "type": "object",
            "properties": {
                "url": {
                    "type": "string"
                },
                "method": {
                    "type": "string",
                    "enum": [
                        "POST",
                        "GET"
                    ]
                },
                "messageWrapper": {
                    "type": "string"
                }
            },
            "required": [
                "url"
            ],
            "additionalProperties": false
        },
        "INotificationConfigTelegram": {
            "type": "object",
            "properties": {
                "chatIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "chatIds"
            ],
            "additionalProperties": false
        }
    }
}
