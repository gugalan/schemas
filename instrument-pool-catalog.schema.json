{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/IInstrumentPoolCatalog",
    "definitions": {
        "IInstrumentPoolCatalog": {
            "type": "object",
            "properties": {
                "$schema": {
                    "type": "string"
                },
                "membershipSources": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "categoryConfigs": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/IInstrumentPoolCategoryConfig"
                    }
                },
                "pools": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IInstrumentPool"
                    }
                }
            },
            "required": [
                "membershipSources",
                "categoryConfigs",
                "pools"
            ],
            "additionalProperties": false,
            "description": "Global instrument pool catalog"
        },
        "IInstrumentPoolCategoryConfig": {
            "type": "object",
            "properties": {
                "sicCodes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "sicCodes"
            ],
            "additionalProperties": false
        },
        "IInstrumentPool": {
            "anyOf": [
                {
                    "$ref": "#/definitions/IInstrumentPoolManual"
                },
                {
                    "$ref": "#/definitions/IInstrumentPoolDynamic"
                },
                {
                    "$ref": "#/definitions/IInstrumentPoolEventDriven"
                }
            ]
        },
        "IInstrumentPoolManual": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "parent": {
                    "type": "string"
                },
                "materialize": {
                    "type": "boolean"
                },
                "kind": {
                    "type": "string",
                    "const": "manual"
                },
                "symbols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "id",
                "kind",
                "symbols"
            ],
            "additionalProperties": false,
            "description": "Manual pool descriptor"
        },
        "IInstrumentPoolDynamic": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "parent": {
                    "type": "string"
                },
                "materialize": {
                    "type": "boolean"
                },
                "kind": {
                    "type": "string",
                    "const": "dynamic"
                },
                "base": {
                    "$ref": "#/definitions/IInstrumentPoolDynamicBase"
                },
                "filters": {
                    "$ref": "#/definitions/IInstrumentPoolDynamicFilters"
                },
                "ranking": {
                    "$ref": "#/definitions/IInstrumentPoolDynamicRanking"
                },
                "selection": {
                    "$ref": "#/definitions/IInstrumentPoolDynamicSelection"
                }
            },
            "required": [
                "id",
                "kind"
            ],
            "additionalProperties": false,
            "description": "Dynamic pool descriptor"
        },
        "IInstrumentPoolDynamicBase": {
            "anyOf": [
                {
                    "$ref": "#/definitions/IInstrumentPoolDynamicBaseMembership"
                },
                {
                    "$ref": "#/definitions/IInstrumentPoolDynamicBaseCategory"
                },
                {
                    "$ref": "#/definitions/IInstrumentPoolDynamicBaseCommonStocks"
                }
            ]
        },
        "IInstrumentPoolDynamicBaseMembership": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "membership"
                },
                "source": {
                    "type": "string"
                }
            },
            "required": [
                "type",
                "source"
            ],
            "additionalProperties": false
        },
        "IInstrumentPoolDynamicBaseCategory": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "category"
                },
                "category": {
                    "type": "string"
                }
            },
            "required": [
                "type",
                "category"
            ],
            "additionalProperties": false
        },
        "IInstrumentPoolDynamicBaseCommonStocks": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "common-stocks"
                }
            },
            "required": [
                "type"
            ],
            "additionalProperties": false
        },
        "IInstrumentPoolDynamicFilters": {
            "type": "object",
            "properties": {
                "locale": {
                    "type": "string"
                },
                "minPrice": {
                    "type": "number"
                },
                "maxPrice": {
                    "type": "number"
                },
                "liquidity": {
                    "$ref": "#/definitions/IInstrumentPoolDynamicLiquidityFilter"
                },
                "volatility": {
                    "$ref": "#/definitions/IInstrumentPoolDynamicVolatilityFilter"
                },
                "activity": {
                    "$ref": "#/definitions/IInstrumentPoolDynamicActivityFilter"
                },
                "shareClassSharesOutstanding": {
                    "$ref": "#/definitions/IInstrumentPoolDynamicShareClassSharesOutstandingFilter"
                }
            },
            "additionalProperties": false
        },
        "IInstrumentPoolDynamicLiquidityFilter": {
            "type": "object",
            "properties": {
                "lookbackDays": {
                    "type": "number"
                },
                "minMedianDollarVolume": {
                    "type": "number"
                }
            },
            "required": [
                "lookbackDays"
            ],
            "additionalProperties": false
        },
        "IInstrumentPoolDynamicVolatilityFilter": {
            "type": "object",
            "properties": {
                "metric": {
                    "type": "string",
                    "const": "atrPercent"
                },
                "lookbackDays": {
                    "type": "number"
                },
                "min": {
                    "type": "number"
                },
                "max": {
                    "type": "number"
                }
            },
            "required": [
                "metric",
                "lookbackDays"
            ],
            "additionalProperties": false
        },
        "IInstrumentPoolDynamicActivityFilter": {
            "type": "object",
            "properties": {
                "window": {
                    "type": "string",
                    "enum": [
                        "prevday",
                        "premarket"
                    ]
                },
                "minPrice": {
                    "type": "number"
                },
                "maxPrice": {
                    "type": "number"
                },
                "minVolume": {
                    "type": "number"
                },
                "minDollarVolume": {
                    "type": "number"
                },
                "minAbsMovePercent": {
                    "type": "number"
                },
                "minGapPercent": {
                    "type": "number"
                },
                "minRangePercent": {
                    "type": "number"
                },
                "minRelativeVolume": {
                    "type": "number"
                },
                "relativeVolumeLookbackDays": {
                    "type": "number"
                },
                "minVolumeShareClassSharesOutstandingMultiple": {
                    "type": "number"
                }
            },
            "required": [
                "window"
            ],
            "additionalProperties": false
        },
        "IInstrumentPoolDynamicShareClassSharesOutstandingFilter": {
            "type": "object",
            "properties": {
                "min": {
                    "type": "number"
                },
                "max": {
                    "type": "number"
                }
            },
            "additionalProperties": false
        },
        "IInstrumentPoolDynamicRanking": {
            "type": "object",
            "properties": {
                "by": {
                    "type": "string",
                    "enum": [
                        "medianDollarVolume",
                        "activityDollarVolume",
                        "activityGapPercent",
                        "activityScore"
                    ]
                },
                "direction": {
                    "type": "string",
                    "enum": [
                        "asc",
                        "desc"
                    ]
                }
            },
            "required": [
                "by"
            ],
            "additionalProperties": false
        },
        "IInstrumentPoolDynamicSelection": {
            "type": "object",
            "properties": {
                "top": {
                    "type": "number"
                },
                "correlation": {
                    "type": "object",
                    "properties": {
                        "lookbackDays": {
                            "type": "number"
                        },
                        "threshold": {
                            "type": "number"
                        },
                        "maxCorrelatedSelected": {
                            "type": "number"
                        },
                        "preselect": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "lookbackDays",
                        "threshold"
                    ],
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "IInstrumentPoolEventDriven": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "parent": {
                    "type": "string"
                },
                "materialize": {
                    "type": "boolean"
                },
                "kind": {
                    "type": "string",
                    "const": "event-driven"
                },
                "eventSource": {
                    "type": "string"
                }
            },
            "required": [
                "eventSource",
                "id",
                "kind"
            ],
            "additionalProperties": false,
            "description": "Event-driven pool descriptor"
        }
    }
}
