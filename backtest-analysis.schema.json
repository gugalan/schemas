{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/IBacktestAnalysisArtifact",
    "definitions": {
        "IBacktestAnalysisArtifact": {
            "type": "object",
            "properties": {
                "accounts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IBacktestAnalysisAccount"
                    }
                },
                "content": {
                    "$ref": "#/definitions/IBacktestAnalysisLocalizedEditorialContent"
                },
                "strategies": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IBacktestAnalysisStrategy"
                    }
                },
                "verdict": {
                    "$ref": "#/definitions/BacktestAnalysisVerdict"
                },
                "analyzedAt": {
                    "type": "string"
                },
                "journalId": {
                    "type": "string"
                },
                "provenance": {
                    "$ref": "#/definitions/IBacktestAnalysisProvenance"
                },
                "schemaVersion": {
                    "type": "number",
                    "const": 4
                }
            },
            "required": [
                "accounts",
                "analyzedAt",
                "content",
                "journalId",
                "provenance",
                "schemaVersion",
                "strategies",
                "verdict"
            ],
            "additionalProperties": false
        },
        "IBacktestAnalysisAccount": {
            "type": "object",
            "properties": {
                "accountId": {
                    "type": "string"
                },
                "benchmarks": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IBacktestAnalysisBenchmark"
                    }
                },
                "content": {
                    "$ref": "#/definitions/IBacktestAnalysisLocalizedAccountContent"
                },
                "verdict": {
                    "$ref": "#/definitions/BacktestAnalysisVerdict"
                }
            },
            "required": [
                "accountId",
                "benchmarks",
                "content",
                "verdict"
            ],
            "additionalProperties": false
        },
        "IBacktestAnalysisBenchmark": {
            "type": "object",
            "properties": {
                "benchmarkId": {
                    "type": "string"
                },
                "content": {
                    "$ref": "#/definitions/IBacktestAnalysisLocalizedText"
                },
                "name": {
                    "type": "string"
                }
            },
            "required": [
                "benchmarkId",
                "content",
                "name"
            ],
            "additionalProperties": false
        },
        "IBacktestAnalysisLocalizedText": {
            "type": "object",
            "properties": {
                "en": {
                    "type": "string"
                },
                "it": {
                    "type": "string"
                }
            },
            "required": [
                "en",
                "it"
            ],
            "additionalProperties": false
        },
        "IBacktestAnalysisLocalizedAccountContent": {
            "type": "object",
            "properties": {
                "en": {
                    "$ref": "#/definitions/IBacktestAnalysisAccountContent"
                },
                "it": {
                    "$ref": "#/definitions/IBacktestAnalysisAccountContent"
                }
            },
            "required": [
                "en",
                "it"
            ],
            "additionalProperties": false
        },
        "IBacktestAnalysisAccountContent": {
            "type": "object",
            "properties": {
                "diagnostics": {
                    "$ref": "#/definitions/IBacktestAnalysisDiagnostics"
                },
                "economics": {
                    "$ref": "#/definitions/IBacktestAnalysisEconomics"
                },
                "resultInterpretation": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "diagnostics",
                "economics",
                "resultInterpretation"
            ],
            "additionalProperties": false
        },
        "IBacktestAnalysisDiagnostics": {
            "type": "object",
            "properties": {
                "excursions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "exits": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "profiler": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "sessions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "sides": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "symbols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "temporal": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "excursions",
                "exits",
                "profiler",
                "sessions",
                "sides",
                "symbols",
                "temporal"
            ],
            "additionalProperties": false
        },
        "IBacktestAnalysisEconomics": {
            "type": "object",
            "properties": {
                "capitalEfficiency": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "concentration": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "costs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "capitalEfficiency",
                "concentration",
                "costs"
            ],
            "additionalProperties": false
        },
        "BacktestAnalysisVerdict": {
            "type": "string",
            "enum": [
                "favorable",
                "mixed",
                "unfavorable",
                "inconclusive"
            ]
        },
        "IBacktestAnalysisLocalizedEditorialContent": {
            "type": "object",
            "properties": {
                "en": {
                    "$ref": "#/definitions/IBacktestAnalysisEditorialContent"
                },
                "it": {
                    "$ref": "#/definitions/IBacktestAnalysisEditorialContent"
                }
            },
            "required": [
                "en",
                "it"
            ],
            "additionalProperties": false
        },
        "IBacktestAnalysisEditorialContent": {
            "type": "object",
            "properties": {
                "executiveSummary": {
                    "type": "string"
                },
                "fallacies": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "limitations": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "recommendation": {
                    "type": "string"
                }
            },
            "required": [
                "executiveSummary",
                "fallacies",
                "limitations",
                "recommendation"
            ],
            "additionalProperties": false
        },
        "IBacktestAnalysisStrategy": {
            "type": "object",
            "properties": {
                "content": {
                    "$ref": "#/definitions/IBacktestAnalysisLocalizedStrategyContent"
                },
                "productionReadiness": {
                    "$ref": "#/definitions/StrategyProductionReadiness"
                },
                "strategyId": {
                    "type": "string"
                }
            },
            "required": [
                "content",
                "productionReadiness",
                "strategyId"
            ],
            "additionalProperties": false
        },
        "IBacktestAnalysisLocalizedStrategyContent": {
            "type": "object",
            "properties": {
                "en": {
                    "$ref": "#/definitions/IBacktestAnalysisStrategyContent"
                },
                "it": {
                    "$ref": "#/definitions/IBacktestAnalysisStrategyContent"
                }
            },
            "required": [
                "en",
                "it"
            ],
            "additionalProperties": false
        },
        "IBacktestAnalysisStrategyContent": {
            "type": "object",
            "properties": {
                "readinessRationale": {
                    "type": "string"
                }
            },
            "required": [
                "readinessRationale"
            ],
            "additionalProperties": false
        },
        "StrategyProductionReadiness": {
            "type": "string",
            "enum": [
                "ready",
                "candidate",
                "noGo",
                "unclear"
            ]
        },
        "IBacktestAnalysisProvenance": {
            "type": "object",
            "properties": {
                "evidenceFingerprint": {
                    "type": "string"
                },
                "fingerprintVersion": {
                    "type": "string",
                    "const": "sha256-v1"
                },
                "implementationSources": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IBacktestAnalysisImplementationSource"
                    }
                }
            },
            "required": [
                "evidenceFingerprint",
                "fingerprintVersion",
                "implementationSources"
            ],
            "additionalProperties": false
        },
        "IBacktestAnalysisImplementationSource": {
            "type": "object",
            "properties": {
                "basis": {
                    "$ref": "#/definitions/BacktestAnalysisSourceBasis"
                },
                "repositoryRelativePath": {
                    "type": "string"
                },
                "sha256": {
                    "type": "string"
                },
                "strategyId": {
                    "type": "string"
                }
            },
            "required": [
                "basis",
                "strategyId"
            ],
            "additionalProperties": false
        },
        "BacktestAnalysisSourceBasis": {
            "type": "string",
            "enum": [
                "run-captured",
                "current-repository",
                "unavailable"
            ]
        }
    }
}
