{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/IConfig",
    "definitions": {
        "IConfig": {
            "type": "object",
            "properties": {
                "$schema": {
                    "type": "string"
                },
                "miner": {
                    "$ref": "#/definitions/IConfigMiner",
                    "description": "Miner configuration"
                },
                "trader": {
                    "$ref": "#/definitions/IConfigTrader",
                    "description": "Trader configuration"
                },
                "batchServices": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/IConfigBatchService"
                    },
                    "description": "Third-party batch service configuration used by scheduler and importers"
                }
            },
            "required": [
                "trader"
            ],
            "additionalProperties": false,
            "description": "Main configuration"
        },
        "IConfigMiner": {
            "type": "object",
            "properties": {
                "kinds": {
                    "type": "object",
                    "properties": {
                        "intraday": {
                            "$ref": "#/definitions/IConfigMinerKind"
                        },
                        "swing": {
                            "$ref": "#/definitions/IConfigMinerKind"
                        },
                        "position": {
                            "$ref": "#/definitions/IConfigMinerKind"
                        }
                    },
                    "additionalProperties": false,
                    "description": "Mining configuration by horizon kind"
                }
            },
            "required": [
                "kinds"
            ],
            "additionalProperties": false,
            "description": "Miner configuration"
        },
        "IConfigMinerKind": {
            "type": "object",
            "properties": {
                "minMovePerc": {
                    "type": "number",
                    "description": "Minimum absolute hindsight movement, expressed as a percentage of entry price.",
                    "minimum": 0
                }
            },
            "required": [
                "minMovePerc"
            ],
            "additionalProperties": false,
            "description": "Mining configuration for one horizon kind"
        },
        "IConfigTrader": {
            "type": "object",
            "properties": {
                "strategies": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/StrategySlug"
                    },
                    "description": "Production strategy slugs available to the trader runtime, composed as `<series>.<branch>`"
                },
                "instrumentUniverse": {
                    "$ref": "#/definitions/IConfigInstrumentUniverse",
                    "description": "Instrument universe requested by the trader config"
                },
                "accountRiskProfiles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IConfigAccountRiskProfile"
                    },
                    "description": "Reusable risk profiles available to accounts"
                },
                "strategyRiskProfiles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IConfigStrategyRiskProfile"
                    },
                    "description": "Unified strategy risk profiles keyed by id"
                },
                "maxContextBars": {
                    "type": "number",
                    "description": "Max bars per timeframe cached in context (memory/perf trade-off)"
                },
                "avoidRoundShareQuantities": {
                    "type": "boolean",
                    "description": "Avoid stock entry order sizes ending in 0 or 5 by subtracting two shares"
                },
                "approachingSignals": {
                    "$ref": "#/definitions/IConfigApproachSignals",
                    "description": "Approaching (pre-trigger) signals configuration"
                },
                "backtest": {
                    "$ref": "#/definitions/IConfigBacktest",
                    "description": "Backtest configuration"
                },
                "live": {
                    "$ref": "#/definitions/IConfigLiveTrading",
                    "description": "Live trading configuration"
                },
                "notifications": {
                    "type": "object",
                    "properties": {
                        "info": {
                            "$ref": "#/definitions/INotificationConfig"
                        },
                        "error": {
                            "$ref": "#/definitions/INotificationConfig"
                        }
                    },
                    "additionalProperties": false,
                    "description": "Notification channels keyed by type"
                }
            },
            "required": [
                "strategies",
                "instrumentUniverse",
                "accountRiskProfiles",
                "strategyRiskProfiles",
                "maxContextBars",
                "approachingSignals",
                "backtest",
                "live",
                "notifications"
            ],
            "additionalProperties": false,
            "description": "Trader configuration"
        },
        "StrategySlug": {
            "type": "string",
            "const": "argo.base",
            "description": "Public production strategy slug type."
        },
        "IConfigInstrumentUniverse": {
            "type": "object",
            "properties": {
                "poolIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Optional run-level pool ids selected from the global instrument pool catalog"
                },
                "symbols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Explicit symbols added on top of the selected pools"
                },
                "excludedSymbols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Symbols excluded globally from the resolved universe"
                }
            },
            "additionalProperties": false,
            "description": "Instrument universe configuration"
        },
        "IConfigAccountRiskProfile": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Unique id for this account risk profile"
                },
                "minCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue",
                    "description": "Minimum capital required to open a trade. Orders whose final allocated capital is below this threshold are discarded. Example: 1_000 means skip trades that would allocate less than $1k."
                },
                "maxCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue",
                    "description": "Max capital to allocate per trade; converted to shares/contracts by the broker adapter. Example: 10_000 means never size above $10k notional per position."
                },
                "maxLossPerDay": {
                    "$ref": "#/definitions/ICompositeValue",
                    "description": "Max loss per day before all activity stops for the account"
                },
                "maxSpreadPerTrade": {
                    "$ref": "#/definitions/ICompositeValue",
                    "description": "Max spread allowed to open; wider spreads skip the trade"
                },
                "maxDailyVolumeParticipationPerTrade": {
                    "type": "number",
                    "description": "Max fraction of recent daily volume that a new order may request."
                },
                "minRecentExecutionBars": {
                    "type": "number",
                    "description": "Number of recent completed one-minute execution bars that must exist and be continuous before opening."
                },
                "maxExecutionBarGapFactor": {
                    "type": "number",
                    "description": "Maximum allowed gap between consecutive completed one-minute execution bars, expressed as a multiple of one minute."
                },
                "minSignalScore": {
                    "type": "number",
                    "description": "Minimum signal score required to place trades (0..1)"
                }
            },
            "required": [
                "id"
            ],
            "additionalProperties": false,
            "description": "Account risk profile configuration"
        },
        "ICompositeValue": {
            "type": "object",
            "properties": {
                "value": {
                    "type": "number"
                },
                "type": {
                    "$ref": "#/definitions/IValueKind",
                    "description": "Default is \"fixed\""
                }
            },
            "required": [
                "value"
            ],
            "additionalProperties": false
        },
        "IValueKind": {
            "type": "string",
            "enum": [
                "fixed",
                "perc"
            ]
        },
        "IConfigStrategyRiskProfile": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/definitions/StrategyRiskProfileId",
                    "description": "Unique id for this strategy risk profile"
                },
                "maxRiskPercPerTrade": {
                    "type": "number",
                    "description": "Max risk fraction per trade; modifiers can only reduce this."
                },
                "maxDrawdownPercPerDay": {
                    "type": "number",
                    "description": "Max daily drawdown (fraction of equity); trading is blocked when breached."
                },
                "expectancyCap": {
                    "type": "number",
                    "description": "Expectancy threshold above which the derived \"quality\" score is clamped to 1."
                },
                "sentimentImpact": {
                    "type": "number",
                    "description": "Optional maximum absolute fractional adjustment to position sizing driven by sentiment signals."
                },
                "hv": {
                    "$ref": "#/definitions/IConfigHVRule",
                    "description": "Historical volatility-based multipliers and shock model"
                },
                "backtest": {
                    "type": "object",
                    "properties": {
                        "spreadFactor": {
                            "type": "number",
                            "description": "Spread factor applied during backtesting"
                        },
                        "slippageFactor": {
                            "type": "number",
                            "description": "Slippage factor applied during backtesting"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "required": [
                "id",
                "maxRiskPercPerTrade",
                "maxDrawdownPercPerDay"
            ],
            "additionalProperties": false,
            "description": "Strategy risk profile configuration"
        },
        "StrategyRiskProfileId": {
            "type": "string",
            "enum": [
                "default",
                "eventDriven",
                "scalping.trend",
                "scalping.breakout",
                "scalping.meanReversion",
                "scalping.range",
                "scalping.liquidity",
                "scalping.volatility",
                "intraday.trend",
                "intraday.breakout",
                "intraday.meanReversion",
                "intraday.range",
                "intraday.liquidity",
                "intraday.futures",
                "intraday.volatility",
                "swing.trend",
                "swing.breakout",
                "swing.meanReversion",
                "swing.range",
                "swing.liquidity",
                "swing.volatility",
                "position.trend",
                "position.breakout",
                "position.meanReversion",
                "position.range",
                "position.liquidity",
                "position.volatility"
            ]
        },
        "IConfigHVRule": {
            "type": "object",
            "properties": {
                "bands": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "threshold": {
                                "type": [
                                    "number",
                                    "null"
                                ],
                                "description": "Upper bound for this band; if null, this is the catch-all band."
                            },
                            "riskMultiplier": {
                                "type": "number",
                                "description": "Risk multiplier applied when value falls into this band"
                            }
                        },
                        "required": [
                            "threshold",
                            "riskMultiplier"
                        ],
                        "additionalProperties": false
                    }
                },
                "lookbackDays": {
                    "type": "number",
                    "description": "Daily bars used to compute hvDaily for this profile. This sets the lookback window for volatility, not the sizing formula itself. Example: 10 for scalping, 20 for intraday, 30 for swing, 60 for position."
                },
                "shock": {
                    "type": "number",
                    "description": "Multiple of daily HV used to estimate a \"shock\" per unit when no explicit stop distance is provided by the strategy. perUnitRisk = hvDaily * hvShockMultiple * price. Example: 1.5 ≈ 1.5 sigma shock."
                }
            },
            "required": [
                "bands",
                "lookbackDays",
                "shock"
            ],
            "additionalProperties": false,
            "description": "Historical volatility-based risk rule configuration"
        },
        "IConfigApproachSignals": {
            "type": "object",
            "properties": {
                "active": {
                    "type": "object",
                    "properties": {
                        "live": {
                            "type": "boolean"
                        },
                        "backtest": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "live",
                        "backtest"
                    ],
                    "additionalProperties": false,
                    "description": "Whether to consider approaching (pre-trigger) signals in order creation"
                },
                "notify": {
                    "type": "boolean",
                    "description": "Whether to send notifications for approaching signals"
                }
            },
            "required": [
                "active",
                "notify"
            ],
            "additionalProperties": false,
            "description": "Approaching (pre-trigger) signals configuration"
        },
        "IConfigBacktest": {
            "type": "object",
            "properties": {
                "performanceScoreMode": {
                    "$ref": "#/definitions/PerformanceScoreMode",
                    "description": "Performance score policy frozen before the backtest starts"
                },
                "startDate": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Start date; if missing, use maximum available local history"
                },
                "endDate": {
                    "type": "string",
                    "format": "date-time",
                    "description": "End date; if missing, run up to current date"
                },
                "spread": {
                    "$ref": "#/definitions/ICompositeDynamicValue",
                    "description": "Simulated spread to inject in fills"
                },
                "slippage": {
                    "$ref": "#/definitions/ICompositeDynamicValue",
                    "description": "Simulated slippage per trade"
                },
                "optimization": {
                    "$ref": "#/definitions/IConfigBacktestOptimization",
                    "description": "Optional optimization mode. This preserves trading behavior but reduces audit and curve persistence to improve throughput."
                },
                "profiling": {
                    "type": "boolean",
                    "description": "Optional profiling for the historical backtest pipeline"
                },
                "journalKind": {
                    "$ref": "#/definitions/JournalKind",
                    "description": "Logical journal kind to assign to this backtest"
                },
                "initialCapital": {
                    "type": "number",
                    "description": "Initial capital for backtesting"
                }
            },
            "required": [
                "performanceScoreMode",
                "initialCapital"
            ],
            "additionalProperties": false,
            "description": "Backtest configuration"
        },
        "PerformanceScoreMode": {
            "type": "string",
            "enum": [
                "disabled",
                "causal"
            ]
        },
        "ICompositeDynamicValue": {
            "anyOf": [
                {
                    "$ref": "#/definitions/ICompositeValue"
                },
                {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "const": "dynamic"
                        }
                    },
                    "required": [
                        "type"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "IConfigBacktestOptimization": {
            "type": "object",
            "properties": {
                "omitSignals": {
                    "type": "boolean",
                    "description": "Omit signals table rows during the run"
                },
                "omitNotifications": {
                    "type": "boolean",
                    "description": "Omit notification log entries during the run"
                },
                "omitEquityCurve": {
                    "type": "boolean",
                    "description": "Omit intermediate equity snapshots during the run"
                }
            },
            "additionalProperties": false,
            "description": "Optimization configuration"
        },
        "JournalKind": {
            "type": "string",
            "enum": [
                "standard",
                "research",
                "oracle"
            ]
        },
        "IConfigLiveTrading": {
            "type": "object",
            "properties": {
                "performanceScoreMode": {
                    "$ref": "#/definitions/PerformanceScoreMode",
                    "description": "Performance score policy frozen when the live trader starts or restarts"
                },
                "warmUpBarsCount": {
                    "type": "number",
                    "description": "Number of bars to warm up the context before starting live trading"
                }
            },
            "required": [
                "performanceScoreMode",
                "warmUpBarsCount"
            ],
            "additionalProperties": false,
            "description": "Live trading configuration"
        },
        "INotificationConfig": {
            "type": "object",
            "properties": {
                "channels": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/NotificationChannel"
                    },
                    "description": "Channels where to send notifications - individual notifications can override this"
                },
                "webhooks": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/INotificationConfigWebhook"
                    },
                    "description": "Configuration for webhooks notification"
                },
                "telegram": {
                    "$ref": "#/definitions/INotificationConfigTelegram",
                    "description": "Configuration for notification on Telegram"
                }
            },
            "required": [
                "channels"
            ],
            "additionalProperties": false
        },
        "NotificationChannel": {
            "type": "string",
            "enum": [
                "app",
                "webhook",
                "telegram"
            ],
            "description": "Gugalanna Copyright (c) Daniele Perilli"
        },
        "INotificationConfigWebhook": {
            "type": "object",
            "properties": {
                "url": {
                    "type": "string",
                    "description": "Webhook URL"
                },
                "method": {
                    "type": "string",
                    "enum": [
                        "POST",
                        "GET"
                    ],
                    "description": "HTTP method - Default is 'GET'"
                },
                "messageWrapper": {
                    "type": "string",
                    "description": "Optional message wrapper\n\nSupported placeholders: \n- {body} - the notification message\n- {<meta_key1>}, {<meta_key1>}, ... - the notification meta keys, if any"
                }
            },
            "required": [
                "url"
            ],
            "additionalProperties": false
        },
        "INotificationConfigTelegram": {
            "type": "object",
            "properties": {
                "chatIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "A list of chats where to spread the notifications"
                }
            },
            "required": [
                "chatIds"
            ],
            "additionalProperties": false
        },
        "IConfigBatchService": {
            "type": "object",
            "properties": {
                "rateLimit": {
                    "$ref": "#/definitions/IConfigRateLimit",
                    "description": "Rate limit configuration"
                },
                "meta": {
                    "type": "object",
                    "additionalProperties": {},
                    "description": "Any additional metadata to associate with this service configuration"
                }
            },
            "additionalProperties": false,
            "description": "Third-party batch service configuration"
        },
        "IConfigRateLimit": {
            "type": "object",
            "properties": {
                "requests": {
                    "type": "number",
                    "description": "Maximum number of requests allowed within the window",
                    "minimum": 1
                },
                "windowMs": {
                    "type": "number",
                    "description": "Time window in milliseconds for the rate limit",
                    "minimum": 1
                },
                "minDelayMs": {
                    "type": "number",
                    "description": "Minimum delay in milliseconds between requests",
                    "minimum": 0
                }
            },
            "required": [
                "requests",
                "windowMs"
            ],
            "additionalProperties": false,
            "description": "Rate limit configuration"
        }
    }
}
