{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/IEffectiveConfigSnapshot",
    "definitions": {
        "IEffectiveConfigSnapshot": {
            "type": "object",
            "properties": {
                "$schema": {
                    "type": "string"
                },
                "accounts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ITradingAccount"
                    }
                },
                "instrumentSessionProfiles": {
                    "$ref": "#/definitions/IInstrumentSessionProfileCatalog"
                },
                "strategyBindings": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IEffectiveAccountStrategyBinding"
                    }
                },
                "taxProfiles": {
                    "$ref": "#/definitions/ITaxProfileCatalog"
                },
                "trader": {
                    "$ref": "#/definitions/IRuntimeTraderConfig"
                }
            },
            "required": [
                "accounts",
                "instrumentSessionProfiles",
                "strategyBindings",
                "taxProfiles",
                "trader"
            ],
            "additionalProperties": false,
            "description": "Immutable, credential-free runtime inputs persisted with a journal."
        },
        "ITradingAccount": {
            "type": "object",
            "properties": {
                "$schema": {
                    "type": "string"
                },
                "id": {
                    "type": "string",
                    "description": "Account id"
                },
                "type": {
                    "$ref": "#/definitions/TradingAccountType",
                    "description": "Account type"
                },
                "active": {
                    "type": "boolean",
                    "description": "Whether the account is active"
                },
                "instrumentPoolIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Instrument pool ids that the account can use. If undefined, the account can use all instruments available in the context."
                },
                "strategySlugs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/StrategySlug"
                    },
                    "description": "Strategy slugs that the account can use. If undefined, the account can use all configured strategy slugs. Slugs are composed as `<series>.<branch>`."
                },
                "riskProfileId": {
                    "type": "string",
                    "description": "Risk profile id to use"
                },
                "riskDay": {
                    "$ref": "#/definitions/IAccountRiskDayPolicy",
                    "description": "Account-owned daily risk reset policy"
                },
                "currency": {
                    "$ref": "#/definitions/CurrencyCode",
                    "description": "Account base currency"
                },
                "tax": {
                    "type": "object",
                    "properties": {
                        "profileId": {
                            "type": "string",
                            "description": "Country-level tax profile id"
                        },
                        "collectionMode": {
                            "$ref": "#/definitions/TaxCollectionMode",
                            "description": "Universal collection mode used to decide how tax cash is paid"
                        }
                    },
                    "required": [
                        "profileId",
                        "collectionMode"
                    ],
                    "additionalProperties": false,
                    "description": "Optional tax accounting configuration"
                },
                "initialMarginPerContract": {
                    "type": "object",
                    "properties": {
                        "long": {
                            "$ref": "#/definitions/ICompositeGroupPerInstrument"
                        },
                        "short": {
                            "$ref": "#/definitions/ICompositeGroupPerInstrument"
                        }
                    },
                    "additionalProperties": false,
                    "description": "Initial margin requirement per contract side; fixed values are account-currency amounts and `perc` values are ratios of local contract notional."
                },
                "maintenanceMarginPerContract": {
                    "type": "object",
                    "properties": {
                        "long": {
                            "$ref": "#/definitions/ICompositeGroupPerInstrument"
                        },
                        "short": {
                            "$ref": "#/definitions/ICompositeGroupPerInstrument"
                        }
                    },
                    "additionalProperties": false,
                    "description": "Maintenance margin requirement per contract side; fixed values are account-currency amounts and `perc` values are ratios of local contract notional."
                },
                "exchangeCommission": {
                    "$ref": "#/definitions/ICompositeGroup",
                    "description": "Commission applied when converting from source currency to account currency"
                },
                "commissionPerOrder": {
                    "$ref": "#/definitions/ICompositeGroupPerInstrument",
                    "description": "Commission per order side (charged twice for round-trip)"
                },
                "commissionPerContract": {
                    "$ref": "#/definitions/ICompositeGroupPerInstrument",
                    "description": "Commission per contract"
                },
                "allowMarketOrdersInExtendedHours": {
                    "type": "boolean",
                    "description": "Allow market orders in extended hours sessions"
                },
                "brokerAccount": {
                    "$ref": "#/definitions/IBrokerAccount",
                    "description": "Linked broker account information"
                }
            },
            "required": [
                "id",
                "type",
                "active",
                "riskProfileId",
                "riskDay",
                "currency",
                "brokerAccount"
            ],
            "additionalProperties": false
        },
        "TradingAccountType": {
            "type": "string",
            "enum": [
                "paper",
                "live"
            ]
        },
        "StrategySlug": {
            "type": "string",
            "const": "argo.base",
            "description": "Public production strategy slug type."
        },
        "IAccountRiskDayPolicy": {
            "type": "object",
            "properties": {
                "boundary": {
                    "type": "number",
                    "description": "Local boundary encoded as HHMM, where 0 is midnight and 1730 is 17:30"
                },
                "timeZone": {
                    "type": "string",
                    "description": "IANA timezone used to interpret the boundary"
                }
            },
            "required": [
                "boundary",
                "timeZone"
            ],
            "additionalProperties": false,
            "description": "Account-owned boundary used to reset daily risk state independently from instrument sessions."
        },
        "CurrencyCode": {
            "type": "string",
            "enum": [
                "AUD",
                "BGN",
                "BRL",
                "CAD",
                "CHF",
                "CNY",
                "CZK",
                "DKK",
                "EUR",
                "GBP",
                "HKD",
                "HUF",
                "IDR",
                "ILS",
                "INR",
                "ISK",
                "JPY",
                "KRW",
                "MXN",
                "MYR",
                "NOK",
                "NZD",
                "PHP",
                "PLN",
                "RON",
                "SEK",
                "SGD",
                "THB",
                "TRY",
                "USD",
                "ZAR"
            ]
        },
        "TaxCollectionMode": {
            "type": "string",
            "enum": [
                "self_assessed",
                "withheld_by_intermediary",
                "none"
            ]
        },
        "ICompositeGroupPerInstrument": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/definitions/ICompositeGroup",
                "description": "Use symbol, instrument type or currency as key (E.g. AAPL, future, USD). Use `*` for default values"
            },
            "description": "Symbol or instrument type values"
        },
        "ICompositeGroup": {
            "type": "object",
            "properties": {
                "values": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ICompositeValue"
                    }
                },
                "minimum": {
                    "$ref": "#/definitions/ICompositeValue"
                },
                "maximum": {
                    "$ref": "#/definitions/ICompositeValue"
                }
            },
            "required": [
                "values"
            ],
            "additionalProperties": false
        },
        "ICompositeValue": {
            "type": "object",
            "properties": {
                "value": {
                    "type": "number"
                },
                "type": {
                    "$ref": "#/definitions/IValueKind",
                    "description": "Default is \"fixed\""
                }
            },
            "required": [
                "value"
            ],
            "additionalProperties": false
        },
        "IValueKind": {
            "type": "string",
            "enum": [
                "fixed",
                "perc"
            ]
        },
        "IBrokerAccount": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Broker account id"
                },
                "accountNumber": {
                    "type": "string",
                    "description": "Broker account number"
                },
                "type": {
                    "$ref": "#/definitions/BrokerType",
                    "description": "Broker type"
                },
                "apiKey": {
                    "type": "string",
                    "description": "Broker-specific configuration"
                },
                "apiSecret": {
                    "type": "string"
                },
                "allowShorting": {
                    "type": "boolean",
                    "description": "Whether opening short positions is permitted"
                }
            },
            "required": [
                "id",
                "type"
            ],
            "additionalProperties": false
        },
        "BrokerType": {
            "type": "string",
            "enum": [
                "alpaca",
                "interactiveBrokers",
                "simulated"
            ]
        },
        "IInstrumentSessionProfileCatalog": {
            "type": "object",
            "properties": {
                "$schema": {
                    "type": "string"
                },
                "profiles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IInstrumentSessionProfile"
                    }
                }
            },
            "required": [
                "profiles"
            ],
            "additionalProperties": false,
            "description": "Versioned market-hours profiles available to instrument metadata."
        },
        "IInstrumentSessionProfile": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Stable session profile identifier."
                },
                "timeZone": {
                    "type": "string",
                    "description": "IANA timezone owning the local session clock."
                },
                "start": {
                    "$ref": "#/definitions/HHMM",
                    "description": "Inclusive local session start in HHMM format."
                },
                "end": {
                    "$ref": "#/definitions/HHMM",
                    "description": "Exclusive local session end in HHMM format."
                },
                "sessionDateConvention": {
                    "type": "string",
                    "const": "closeDate",
                    "description": "Instrument sessions are labeled by the local date on which they close."
                }
            },
            "required": [
                "id",
                "timeZone",
                "start",
                "end",
                "sessionDateConvention"
            ],
            "additionalProperties": false,
            "description": "Canonical metadata required to resolve one instrument's trading sessions."
        },
        "HHMM": {
            "type": "number"
        },
        "IEffectiveAccountStrategyBinding": {
            "type": "object",
            "properties": {
                "accountId": {
                    "type": "string"
                },
                "strategies": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IEffectiveStrategyBinding"
                    }
                }
            },
            "required": [
                "accountId",
                "strategies"
            ],
            "additionalProperties": false,
            "description": "Concrete strategies resolved for one active account at run start."
        },
        "IEffectiveStrategyBinding": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "key": {
                    "type": "string"
                },
                "riskProfileId": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "key",
                "riskProfileId"
            ],
            "additionalProperties": false,
            "description": "Immutable strategy identity and risk binding used by one run."
        },
        "ITaxProfileCatalog": {
            "type": "object",
            "properties": {
                "$schema": {
                    "type": "string"
                },
                "profiles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ITaxProfile"
                    },
                    "description": "Tax profiles available to trading accounts"
                }
            },
            "required": [
                "profiles"
            ],
            "additionalProperties": false
        },
        "ITaxProfile": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Country-level profile id, normally the ISO 3166-1 alpha-2 country code"
                },
                "country": {
                    "type": "string",
                    "description": "ISO 3166-1 alpha-2 country code"
                },
                "timeZone": {
                    "type": "string",
                    "description": "IANA timezone used to assign civil dates and tax years"
                },
                "versions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ITaxProfileVersion"
                    },
                    "description": "Versioned tax settings for this profile"
                }
            },
            "required": [
                "id",
                "country",
                "timeZone",
                "versions"
            ],
            "additionalProperties": false
        },
        "ITaxProfileVersion": {
            "type": "object",
            "properties": {
                "validFrom": {
                    "type": "string",
                    "description": "First calendar date covered by this tax profile version"
                },
                "validTo": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Exclusive calendar-date boundary for this tax profile version; null means still valid"
                },
                "taxYear": {
                    "$ref": "#/definitions/ITaxYearConfig",
                    "description": "Tax year calendar used by this country profile"
                },
                "realizedProfitTaxRate": {
                    "type": "number",
                    "description": "Tax rate applied to positive net realized PnL"
                },
                "dividendTaxRate": {
                    "type": "number",
                    "description": "Tax rate applied to positive gross dividend income"
                },
                "shortDividendTaxTreatment": {
                    "type": "string",
                    "enum": [
                        "deductible",
                        "non_deductible"
                    ],
                    "description": "Explicit tax policy for short-position dividend cash debits"
                },
                "lossCarryForwardYears": {
                    "type": "number",
                    "description": "Number of tax years where losses may be carried forward"
                }
            },
            "required": [
                "validFrom",
                "taxYear",
                "realizedProfitTaxRate",
                "dividendTaxRate",
                "shortDividendTaxTreatment"
            ],
            "additionalProperties": false
        },
        "ITaxYearConfig": {
            "type": "object",
            "properties": {
                "startMonth": {
                    "type": "number",
                    "description": "Month when the tax year starts, using 1 for January and 12 for December"
                },
                "startDay": {
                    "type": "number",
                    "description": "Day of month when the tax year starts"
                }
            },
            "required": [
                "startMonth",
                "startDay"
            ],
            "additionalProperties": false
        },
        "IRuntimeTraderConfig": {
            "type": "object",
            "properties": {
                "instrumentUniverse": {
                    "$ref": "#/definitions/IConfigInstrumentUniverse",
                    "description": "Instrument universe requested by the trader config"
                },
                "accountRiskProfiles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IConfigAccountRiskProfile"
                    },
                    "description": "Reusable risk profiles available to accounts"
                },
                "strategyRiskProfiles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IConfigStrategyRiskProfile"
                    },
                    "description": "Unified strategy risk profiles keyed by id"
                },
                "maxContextBars": {
                    "type": "number",
                    "description": "Max bars per timeframe cached in context (memory/perf trade-off)"
                },
                "avoidRoundShareQuantities": {
                    "type": "boolean",
                    "description": "Avoid stock entry order sizes ending in 0 or 5 by subtracting two shares"
                },
                "approachingSignals": {
                    "$ref": "#/definitions/IConfigApproachSignals",
                    "description": "Approaching (pre-trigger) signals configuration"
                },
                "backtest": {
                    "$ref": "#/definitions/IConfigBacktest",
                    "description": "Backtest configuration"
                },
                "live": {
                    "$ref": "#/definitions/IConfigLiveTrading",
                    "description": "Live trading configuration"
                },
                "notifications": {
                    "type": "object",
                    "properties": {
                        "info": {
                            "$ref": "#/definitions/INotificationConfig"
                        },
                        "error": {
                            "$ref": "#/definitions/INotificationConfig"
                        }
                    },
                    "additionalProperties": false,
                    "description": "Notification channels keyed by type"
                },
                "strategies": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Strategy slugs or concrete runtime strategy identifiers selected for this run"
                }
            },
            "required": [
                "accountRiskProfiles",
                "approachingSignals",
                "backtest",
                "instrumentUniverse",
                "live",
                "maxContextBars",
                "notifications",
                "strategies",
                "strategyRiskProfiles"
            ],
            "additionalProperties": false,
            "description": "Trader configuration after a runtime entry point selects registered strategy identifiers."
        },
        "IConfigInstrumentUniverse": {
            "type": "object",
            "properties": {
                "poolIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Optional run-level pool ids selected from the global instrument pool catalog"
                },
                "symbols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Explicit symbols added on top of the selected pools"
                },
                "excludedSymbols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Symbols excluded globally from the resolved universe"
                }
            },
            "additionalProperties": false,
            "description": "Instrument universe configuration"
        },
        "IConfigAccountRiskProfile": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Unique id for this account risk profile"
                },
                "minCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue",
                    "description": "Minimum capital required to open a trade. Orders whose final allocated capital is below this threshold are discarded. Example: 1_000 means skip trades that would allocate less than $1k."
                },
                "maxCapitalPerTrade": {
                    "$ref": "#/definitions/ICompositeValue",
                    "description": "Max capital to allocate per trade; converted to shares/contracts by the broker adapter. Example: 10_000 means never size above $10k notional per position."
                },
                "maxLossPerDay": {
                    "$ref": "#/definitions/ICompositeValue",
                    "description": "Max loss per day before all activity stops for the account"
                },
                "maxSpreadPerTrade": {
                    "$ref": "#/definitions/ICompositeValue",
                    "description": "Max spread allowed to open; wider spreads skip the trade"
                },
                "maxDailyVolumeParticipationPerTrade": {
                    "type": "number",
                    "description": "Max ratio of recent daily volume that a new order may request, where 1 is 100%.",
                    "minimum": 0,
                    "maximum": 1
                },
                "minRecentExecutionBars": {
                    "type": "number",
                    "description": "Number of recent completed one-minute execution bars that must exist and be continuous before opening."
                },
                "maxExecutionBarGapFactor": {
                    "type": "number",
                    "description": "Maximum allowed gap between consecutive completed one-minute execution bars, expressed as a multiple of one minute."
                },
                "minSignalScore": {
                    "type": "number",
                    "description": "Minimum signal score required to place trades.",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "required": [
                "id"
            ],
            "additionalProperties": false,
            "description": "Account risk profile configuration"
        },
        "IConfigStrategyRiskProfile": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/definitions/StrategyRiskProfileId",
                    "description": "Unique id for this strategy risk profile"
                },
                "maxRiskPercPerTrade": {
                    "type": "number",
                    "description": "Max risk ratio per trade, where 1 is 100%; modifiers can only reduce this.",
                    "minimum": 0,
                    "maximum": 1
                },
                "maxDrawdownPercPerDay": {
                    "type": "number",
                    "description": "Max daily drawdown ratio, where 1 is 100%; trading is blocked when breached.",
                    "minimum": 0,
                    "maximum": 1
                },
                "hv": {
                    "$ref": "#/definitions/IConfigHVRule",
                    "description": "Historical volatility-based multipliers and shock model"
                },
                "backtest": {
                    "type": "object",
                    "properties": {
                        "spreadFactor": {
                            "type": "number",
                            "description": "Spread factor applied during backtesting"
                        },
                        "slippageFactor": {
                            "type": "number",
                            "description": "Slippage factor applied during backtesting"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "required": [
                "id",
                "maxRiskPercPerTrade",
                "maxDrawdownPercPerDay"
            ],
            "additionalProperties": false,
            "description": "Strategy risk profile configuration"
        },
        "StrategyRiskProfileId": {
            "type": "string",
            "enum": [
                "default",
                "eventDriven",
                "scalping.trend",
                "scalping.breakout",
                "scalping.meanReversion",
                "scalping.range",
                "scalping.liquidity",
                "scalping.volatility",
                "intraday.trend",
                "intraday.breakout",
                "intraday.meanReversion",
                "intraday.range",
                "intraday.liquidity",
                "intraday.futures",
                "intraday.volatility",
                "swing.trend",
                "swing.breakout",
                "swing.meanReversion",
                "swing.range",
                "swing.liquidity",
                "swing.volatility",
                "position.trend",
                "position.breakout",
                "position.meanReversion",
                "position.range",
                "position.liquidity",
                "position.volatility"
            ]
        },
        "IConfigHVRule": {
            "type": "object",
            "properties": {
                "bands": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "threshold": {
                                "type": [
                                    "number",
                                    "null"
                                ],
                                "description": "Upper bound for this band; if null, this is the catch-all band."
                            },
                            "riskMultiplier": {
                                "type": "number",
                                "description": "Risk multiplier applied when value falls into this band"
                            }
                        },
                        "required": [
                            "threshold",
                            "riskMultiplier"
                        ],
                        "additionalProperties": false
                    }
                },
                "lookbackDays": {
                    "type": "number",
                    "description": "Daily bars used to compute hvDaily for this profile. This sets the lookback window for volatility, not the sizing formula itself. Example: 10 for scalping, 20 for intraday, 30 for swing, 60 for position."
                },
                "shock": {
                    "type": "number",
                    "description": "Multiple of daily HV used to estimate a \"shock\" per unit when no explicit stop distance is provided by the strategy. perUnitRisk = hvDaily * hvShockMultiple * price. Example: 1.5 ≈ 1.5 sigma shock."
                }
            },
            "required": [
                "bands",
                "lookbackDays",
                "shock"
            ],
            "additionalProperties": false,
            "description": "Historical volatility-based risk rule configuration"
        },
        "IConfigApproachSignals": {
            "type": "object",
            "properties": {
                "active": {
                    "type": "object",
                    "properties": {
                        "live": {
                            "type": "boolean"
                        },
                        "backtest": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "live",
                        "backtest"
                    ],
                    "additionalProperties": false,
                    "description": "Whether to consider approaching (pre-trigger) signals in order creation"
                },
                "notify": {
                    "type": "boolean",
                    "description": "Whether to send notifications for approaching signals"
                }
            },
            "required": [
                "active",
                "notify"
            ],
            "additionalProperties": false,
            "description": "Approaching (pre-trigger) signals configuration"
        },
        "IConfigBacktest": {
            "type": "object",
            "properties": {
                "useStrategyScores": {
                    "type": "boolean",
                    "description": "Whether the backtest freezes and consumes causal strategy scores before it starts"
                },
                "startDate": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Start date; if missing, use maximum available local history"
                },
                "endDate": {
                    "type": "string",
                    "format": "date-time",
                    "description": "End date; if missing, run up to current date"
                },
                "spread": {
                    "$ref": "#/definitions/ICompositeDynamicValue",
                    "description": "Simulated spread to inject in fills"
                },
                "slippage": {
                    "$ref": "#/definitions/ICompositeDynamicValue",
                    "description": "Simulated slippage per trade"
                },
                "executionBarVolumeParticipation": {
                    "type": "number",
                    "description": "Maximum share of the complete current raw execution bar volume exposed from its opening phase by the intentional ex-post fill model"
                },
                "optimization": {
                    "$ref": "#/definitions/IConfigBacktestOptimization",
                    "description": "Optional optimization mode. These flags preserve strategy-account behavior while omitting selected diagnostics, curves, or independent benchmark accounting to improve throughput."
                },
                "profiling": {
                    "type": "boolean",
                    "description": "Optional profiling for the historical backtest pipeline"
                },
                "journalKind": {
                    "$ref": "#/definitions/JournalKind",
                    "description": "Logical journal kind to assign to this backtest"
                },
                "initialCapital": {
                    "type": "number",
                    "description": "Initial capital for backtesting"
                }
            },
