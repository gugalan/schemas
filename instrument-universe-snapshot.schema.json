{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/IResolvedInstrumentUniverseSnapshot",
    "definitions": {
        "IResolvedInstrumentUniverseSnapshot": {
            "type": "object",
            "properties": {
                "effectiveAt": {
                    "type": "string"
                },
                "pools": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IResolvedInstrumentPool"
                    }
                },
                "symbols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "effectiveAt",
                "pools",
                "symbols"
            ],
            "additionalProperties": false,
            "description": "Materialized universe snapshot"
        },
        "IResolvedInstrumentPool": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "manual",
                        "dynamic",
                        "event-driven"
                    ]
                },
                "effectiveAt": {
                    "type": "string"
                },
                "definitionHash": {
                    "type": "string"
                },
                "materializedAt": {
                    "type": "string"
                },
                "profileBasis": {
                    "$ref": "#/definitions/InstrumentPoolProfileBasis"
                },
                "profileCapturedAt": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "profileSnapshotId": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "symbols": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "id",
                "kind",
                "effectiveAt",
                "definitionHash",
                "materializedAt",
                "profileBasis",
                "profileCapturedAt",
                "profileSnapshotId",
                "symbols"
            ],
            "additionalProperties": false,
            "description": "Materialized pool snapshot"
        },
        "InstrumentPoolProfileBasis": {
            "type": "string",
            "enum": [
                "not-required",
                "current-profile-proxy-v1"
            ]
        }
    }
}
