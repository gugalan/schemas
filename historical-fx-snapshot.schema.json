{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/IHistoricalFxSnapshot",
    "definitions": {
        "IHistoricalFxSnapshot": {
            "type": "object",
            "properties": {
                "version": {
                    "type": "string",
                    "const": "causal-broker-owned-fx-v1"
                },
                "id": {
                    "type": "string"
                },
                "periodStart": {
                    "type": "number"
                },
                "periodEnd": {
                    "type": "number"
                },
                "provider": {
                    "type": "string",
                    "const": "frankfurter-v1"
                },
                "knownAtPolicy": {
                    "type": "string",
                    "const": "next-utc-day"
                },
                "identityCurrencies": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/CurrencyCode"
                    }
                },
                "sourceObservations": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IHistoricalFxSourceObservation"
                    }
                },
                "pairs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IHistoricalFxPairSnapshot"
                    }
                }
            },
            "required": [
                "version",
                "id",
                "periodStart",
                "periodEnd",
                "provider",
                "knownAtPolicy",
                "identityCurrencies",
                "sourceObservations",
                "pairs"
            ],
            "additionalProperties": false,
            "description": "Content-addressed historical FX decision surface frozen before trading starts."
        },
        "CurrencyCode": {
            "type": "string",
            "enum": [
                "AUD",
                "BGN",
                "BRL",
                "CAD",
                "CHF",
                "CNY",
                "CZK",
                "DKK",
                "EUR",
                "GBP",
                "HKD",
                "HUF",
                "IDR",
                "ILS",
                "INR",
                "ISK",
                "JPY",
                "KRW",
                "MXN",
                "MYR",
                "NOK",
                "NZD",
                "PHP",
                "PLN",
                "RON",
                "SEK",
                "SGD",
                "THB",
                "TRY",
                "USD",
                "ZAR"
            ]
        },
        "IHistoricalFxSourceObservation": {
            "type": "object",
            "properties": {
                "baseCurrency": {
                    "type": "string",
                    "const": "EUR"
                },
                "quoteCurrency": {
                    "$ref": "#/definitions/CurrencyCode"
                },
                "rate": {
                    "type": "number"
                },
                "effectiveAt": {
                    "type": "number"
                },
                "knownAt": {
                    "type": "number"
                },
                "provider": {
                    "type": "string",
                    "const": "frankfurter-v1"
                },
                "fingerprint": {
                    "type": "string"
                }
            },
            "required": [
                "baseCurrency",
                "quoteCurrency",
                "rate",
                "effectiveAt",
                "knownAt",
                "provider",
                "fingerprint"
            ],
            "additionalProperties": false,
            "description": "Exact validated provider row retained as immutable run provenance."
        },
        "IHistoricalFxPairSnapshot": {
            "type": "object",
            "properties": {
                "fromCurrency": {
                    "$ref": "#/definitions/CurrencyCode"
                },
                "toCurrency": {
                    "$ref": "#/definitions/CurrencyCode"
                },
                "observations": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/IHistoricalFxRateObservation"
                    }
                }
            },
            "required": [
                "fromCurrency",
                "toCurrency",
                "observations"
            ],
            "additionalProperties": false,
            "description": "Exact pair history required by one backtest run."
        },
        "IHistoricalFxRateObservation": {
            "type": "object",
            "properties": {
                "fromCurrency": {
                    "$ref": "#/definitions/CurrencyCode"
                },
                "toCurrency": {
                    "$ref": "#/definitions/CurrencyCode"
                },
                "rate": {
                    "type": "number"
                },
                "effectiveAt": {
                    "type": "number"
                },
                "knownAt": {
                    "type": "number"
                },
                "provider": {
                    "type": "string",
                    "const": "frankfurter-v1"
                },
                "fingerprint": {
                    "type": "string"
                },
                "sourceFingerprints": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "effectiveAt",
                "fingerprint",
                "fromCurrency",
                "knownAt",
                "provider",
                "rate",
                "sourceFingerprints",
                "toCurrency"
            ],
            "additionalProperties": false,
            "description": "Exact historical cross-currency observation frozen for one backtest run."
        }
    }
}
