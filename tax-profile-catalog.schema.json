{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/ITaxProfileCatalog",
    "definitions": {
        "ITaxProfileCatalog": {
            "type": "object",
            "properties": {
                "$schema": {
                    "type": "string"
                },
                "profiles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ITaxProfile"
                    },
                    "description": "Tax profiles available to trading accounts"
                }
            },
            "required": [
                "profiles"
            ],
            "additionalProperties": false
        },
        "ITaxProfile": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Country-level profile id, normally the ISO 3166-1 alpha-2 country code"
                },
                "country": {
                    "type": "string",
                    "description": "ISO 3166-1 alpha-2 country code"
                },
                "timeZone": {
                    "type": "string",
                    "description": "IANA timezone used to assign civil dates and tax years"
                },
                "versions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ITaxProfileVersion"
                    },
                    "description": "Versioned tax settings for this profile"
                }
            },
            "required": [
                "id",
                "country",
                "timeZone",
                "versions"
            ],
            "additionalProperties": false
        },
        "ITaxProfileVersion": {
            "type": "object",
            "properties": {
                "validFrom": {
                    "type": "string",
                    "description": "First calendar date covered by this tax profile version"
                },
                "validTo": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Exclusive calendar-date boundary for this tax profile version; null means still valid"
                },
                "taxYear": {
                    "$ref": "#/definitions/ITaxYearConfig",
                    "description": "Tax year calendar used by this country profile"
                },
                "realizedProfitTaxRate": {
                    "type": "number",
                    "description": "Tax rate applied to positive net realized PnL"
                },
                "lossCarryForwardYears": {
                    "type": "number",
                    "description": "Number of tax years where losses may be carried forward"
                }
            },
            "required": [
                "validFrom",
                "taxYear",
                "realizedProfitTaxRate"
            ],
            "additionalProperties": false
        },
        "ITaxYearConfig": {
            "type": "object",
            "properties": {
                "startMonth": {
                    "type": "number",
                    "description": "Month when the tax year starts, using 1 for January and 12 for December"
                },
                "startDay": {
                    "type": "number",
                    "description": "Day of month when the tax year starts"
                }
            },
            "required": [
                "startMonth",
                "startDay"
            ],
            "additionalProperties": false
        }
    }
}
